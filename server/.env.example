# Server port
PORT=4000

# Postgres connection string (matches docker-compose.yml, host port 5433)
DATABASE_URL=postgresql://devcommunity:devcommunity@localhost:5433/devcommunity

# Secret used to sign JWT access tokens - use a long random string
JWT_SECRET=

# Access token lifetime (e.g. 1d, 12h)
JWT_EXPIRES_IN=1d

# Allowed origin for CORS (the frontend dev server URL)
CORS_ORIGIN=http://localhost:5174
